<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AcgFotos.Core\AcgFotos.Core.csproj" />
    <ProjectReference Include="..\AcgFotos.Fotos.Domain\AcgFotos.Fotos.Domain.csproj" />
    <ProjectReference Include="..\AcgFotos.Fotos.Application\AcgFotos.Fotos.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pipeline de derivados (ADR-01): decode/resize/encode. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.8" />
    <!-- Composición de capas de marca de agua (ADR-16): ImageSharp no tiene todos los modos de
         fusión (falta Difference); SkiaSharp sí, mismo paquete/versión que el código base. -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Asset por defecto del último escalón de la cascada (sin perfiles cargados): reproduce el
         watermark de texto que dibujaba el pipeline pre-ADR-15, congelado a PNG una sola vez — la API
         no vuelve a dibujar texto nunca (ADR-15 §1). -->
    <EmbeddedResource Include="Imaging\Assets\marca-agua-default.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
